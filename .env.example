# Supabase (obrigatório para cadastro, quiz e admin)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Senha do painel /admin (produção: use valor forte na Vercel)
ADMIN_PASSWORD=altere-esta-senha

# Chave privada: usada somente nas rotas do servidor; nunca use prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sua-chave-privada
# Opcional: segredo exclusivo de assinatura (caso ausente, usa a chave privada)
ADMIN_SESSION_SECRET=
