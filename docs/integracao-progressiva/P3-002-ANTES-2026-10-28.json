  "helpers": [
    {
      "acl": [
        "postgres=X/postgres",
        "authenticated=X/postgres"
      ],
      "def": "CREATE OR REPLACE FUNCTION dna_private.is_platform_owner()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM public.platform_owners o JOIN public.user_profiles p ON p.id=o.user_id WHERE o.user_id=(SELECT auth.uid()) AND o.active AND p.active)\n$function$\n",
      "name": "is_platform_owner"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "authenticated=X/postgres"
      ],
      "def": "CREATE OR REPLACE FUNCTION dna_private.has_institution_membership(target uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM public.institution_memberships m JOIN public.user_profiles p ON p.id=m.user_id JOIN public.institutions i ON i.id=m.institution_id WHERE m.user_id=(SELECT auth.uid()) AND m.institution_id=target AND m.active AND p.active AND i.active)\n$function$\n",
      "name": "has_institution_membership"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "authenticated=X/postgres"
      ],
      "def": "CREATE OR REPLACE FUNCTION dna_private.is_institution_admin(target uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM public.institution_memberships m JOIN public.user_profiles p ON p.id=m.user_id JOIN public.institutions i ON i.id=m.institution_id WHERE m.user_id=(SELECT auth.uid()) AND m.institution_id=target AND m.active AND p.active AND i.active AND NOT m.scope_pending AND m.role_code='institution_admin')\n$function$\n",
      "name": "is_institution_admin"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "authenticated=X/postgres"
      ],
      "def": "CREATE OR REPLACE FUNCTION dna_private.is_active_user()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n SELECT EXISTS(SELECT 1 FROM public.user_profiles p WHERE p.id=(SELECT auth.uid()) AND p.active)\n$function$\n",
      "name": "is_active_user"
    }
  ],
